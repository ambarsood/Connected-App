# Firebase web app config
VITE_FIREBASE_API_KEY=your_firebase_api_key
VITE_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_project.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
VITE_FIREBASE_APP_ID=your_firebase_app_id

# Frontend API URL
# Leave empty for Docker local dev because Vite proxies /api to the server container.
VITE_API_BASE_URL=

# Backend
PORT=5000
CLIENT_ORIGIN=http://localhost:5173

# Firebase Admin SDK JSON as a single-line JSON string.
# Never commit the real value.
FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"your_project_id"}
